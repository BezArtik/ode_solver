BasedOnStyle: Google
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 120
AccessModifierOffset: -4
BreakBeforeBraces: Attach
NamespaceIndentation: None


SortIncludes: true
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^"(.*)\.hpp"$'
    Priority: 1
  - Regex: '^"(core|utils|methods|expr|io)/'
    Priority: 2
  - Regex: '^<'
    Priority: 3

AllowShortFunctionsOnASingleLine: Inline
